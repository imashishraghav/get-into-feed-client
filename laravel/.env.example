APP_NAME="GetIntoFeed Enterprise CMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# Supabase (PostgreSQL) Configuration Example:
# DB_CONNECTION=pgsql
# DB_HOST=aws-0-ap-south-1.pooler.supabase.com
# DB_PORT=6543
# DB_DATABASE=postgres
# DB_USERNAME=postgres.YOUR_PROJECT_REF
# DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD
# DB_SCHEMA=public
# DB_SSLMODE=require

SESSION_DRIVER=file
SESSION_LIFETIME=60
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# In production this is enabled automatically; set it explicitly to true on Hostinger.
# SESSION_SECURE_COOKIE=true

# Keep localhost origins only in local development. Production should list only the public site origins.
CORS_ALLOWED_ORIGINS=https://getintofeed.com,https://www.getintofeed.com,http://localhost:5173,http://127.0.0.1:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=file
CACHE_PREFIX=gif_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USERNAME=hello@getintofeed.com
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@getintofeed.com"
MAIL_FROM_NAME="GetIntoFeed Creative Studio"
LEAD_NOTIFICATION_RECIPIENT="hello@getintofeed.com"

FILAMENT_PATH=admin
FILAMENT_DOMAIN=null

# Google Tag Manager & Analytics IDs
GTM_CONTAINER_ID=
GA4_MEASUREMENT_ID=

# Optional one-time owner bootstrap for `php artisan db:seed`.
# No account is created unless all three values are supplied explicitly.
ADMIN_BOOTSTRAP_NAME=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# External CRM Sync (crm.getintofeed.com)
CRM_API_ENDPOINT=https://crm.getintofeed.com/api/v1/inbound-leads
CRM_SYNC_SECRET=
CRM_SYNC_TIMEOUT=10
