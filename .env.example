# ==============================================================================
# GetIntoFeed Agency CRM & Client Delivery OS ("FeedOS")
# Production Environment Variable Reference (.env.example)
# ==============================================================================
# ZERO CREDENTIALS POLICY:
# Every third-party integration uses the Adapter Pattern (Interface + Mock + Production).
# By default, all *_MOCK flags are set to 'true'. FeedOS boots and operates 100%
# end-to-end locally with ZERO external credentials, API keys, or accounts required.
# ==============================================================================

# Core Application Settings
NODE_ENV=development
PORT=3000
APP_NAME="GetIntoFeed Agency OS"
APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_jwt_secret_min_32_chars_random_string

# Database & Cache (PostgreSQL 16 + Redis 7)
DATABASE_URL="postgresql://feedos:FeedOsSecure2026!@localhost:5432/getintofeed_crm?schema=public"
REDIS_URL="redis://localhost:6379"

# Zero-Credential Mock Adapter Toggles (true = zero credentials; false = production)
USE_MOCK_ADAPTERS=true
WHATSAPP_MOCK=true
PAYMENT_MOCK=true
ESIGN_MOCK=true
TELEPHONY_MOCK=true
EMAIL_MOCK=true

# ------------------------------------------------------------------------------
# Production Adapters (Optional: Populated only when switching mocks to false)
# ------------------------------------------------------------------------------

# 1. WhatsApp Cloud API (Meta for Developers)
# Required only if WHATSAPP_MOCK=false
META_WHATSAPP_TOKEN=""
META_PHONE_NUMBER_ID=""
META_WABA_ID=""
META_WEBHOOK_VERIFY_TOKEN="getintofeed_wa_verify_token_2026"

# 2. Razorpay Indian Payments & UPI
# Required only if PAYMENT_MOCK=false
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
AGENCY_UPI_VPA="getintofeed.agency@icici"

# 3. Digio / Leegality Aadhaar E-Sign
# Required only if ESIGN_MOCK=false
DIGIO_CLIENT_ID=""
DIGIO_CLIENT_SECRET=""
LEEGALITY_AUTH_TOKEN=""

# 4. Exotel Indian Telephony (Click-to-Call & Virtual Numbers)
# Required only if TELEPHONY_MOCK=false
EXOTEL_SID=""
EXOTEL_API_KEY=""
EXOTEL_API_TOKEN=""
EXOTEL_CALLER_ID=""

# 5. Resend / Transactional Email
# Required only if EMAIL_MOCK=false
RESEND_API_KEY=""
EMAIL_FROM="GetIntoFeed Studio <updates@getintofeed.com>"

# ------------------------------------------------------------------------------
# Statutory Agency Financial Information (Delhi NCR)
# ------------------------------------------------------------------------------
AGENCY_NAME="GetIntoFeed Creative & Performance Studio"
AGENCY_LEGAL_ENTITY="GetIntoFeed Digital LLP"
AGENCY_GSTIN="07AAAAA0000A1Z5"
AGENCY_STATE_CODE="07"
AGENCY_PAN="AAAAA0000A"
AGENCY_SAC_DEFAULT="998361"
AGENCY_INVOICE_PREFIX="GIF/26-27/"
AGENCY_ADDRESS="Plot 44, Okhla Industrial Area Phase III, New Delhi 110020"
AGENCY_SUPPORT_WHATSAPP="+919811000000"
AGENCY_DPO_EMAIL="privacy@getintofeed.com"
