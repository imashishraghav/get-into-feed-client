:     agency: \"Get Into Feed Media Pvt. Ltd.\",\n34:     status: \"ok\",\n35:     service: \"get-into-feed-backend\",\n36:     mcpConnected: true,\n37:     hubs: [\"Bengaluru\", \"Mumbai\", \"Delhi-NCR\"]\n38:   });\n39: });\n40: \n41: // Agency Backend Command & Developer Portal\n42: app.get([\"/portal\", \"/api/portal\"], async (req, res) => {\n43:   const html = await renderBackendPortal(req);\n44:   res.type(\"html\").send(html);\n45: });\n46: \n47: // Standard REST & Site Routes\n48: app.use(\"/api\", siteRoutes);\n49: app.use(\"/api\", leadRoutes);\n50: app.use(\"/api\", applicationRoutes);\n51: app.use(\"/api/admin\", adminRoutes);\n52: \n53: // Model Context Protocol (MCP) Routes (HTTP & SSE transports)\n54: app.use(\"/api/mcp\", mcpRoutes);\n55: app.use(\"/mcp\", mcpRoutes);\n56: \n57: const frontendDist = path.join(__dirname, \"..\", \"frontend\", \"dist\");\n58: \n59: if (process.env.NODE_ENV === \"production\") {\n60:   app.use(express.static(frontendDist));\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
