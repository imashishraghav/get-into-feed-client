d(false), 3000);\\n    } catch {\\n      setCopied(false);\\n    }\\n  };\\n\\n  const linkedInUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`;\\n  const whatsappUrl = `https://wa.me/?text=${encodeURIComponent(`${post.title} - ${url}`)}`;\\n  const twitterUrl = `https://twitter.com/intent/tweet?text=${shareText}&url=${encodeURIComponent(url)}`;\\n\\n  return (\\n    <div style={{ display: \\\"flex\\\", alignItems: \\\"center\\\", gap: \\\"10px\\\", flexWrap: \\\"wrap\\\" }}>\\n      <span style={{ fontSize: \\\"0.82rem\\\", color: \\\"var(--muted)\\\", fontWeight: 700 }}>Share this article:</span>\\n      <div className=\\\"share-btn-group\\\">\\n        <button\\n          type=\\\"button\\\"\\n          className=\\\"share-icon-btn\\\"\\n          onClick={copy}\\n       \n<truncated 12515 bytes>","Description":"\"Update Blog.jsx with authentic editorial style, social share, likes, comments, and recent blogs\"","Overwrite":"true","TargetFile":"\"c:\\\\Users\\\\ashis\\\\OneDrive\\\\Documents\\\\Get into feed\\\\frontend\\\\src\\\\Blog.jsx\"","toolAction":"\"Updating Blog.jsx\"","toolSummary":"\"Update Blog.jsx in editorial style\""}}],"truncated_fields":["tool_calls"]}
