{"step_index":326,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-08-22T10:39:30Z","content":"Created At: 2026-08-22T16:09:30+05:30\nCompleted At: 2026-08-22T16:09:30+05:30\nFile Path: `file:///c:/Users/ashis/OneDrive/Documents/Get%20into%20feed/frontend/src/Admin.jsx`\nTotal Lines: 118\nTotal Bytes: 11262\nShowing lines 105 to 118\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n105:     }\n106:   };\n107: \n108:   if (!dashboard) return <section className=\"admin-login\"><div><span className=\"admin-kicker\"><KeyRound size={16} /> Get Into Feed</span><h1>Admin dashboard</h1><p>Use your private admin access key to manage published content and review website submissions.</p><form onSubmit={(event) => { event.preventDefault(); loadDashboard(token); }}><label>Admin access key<input required type=\"password\" value={token} onChange={(event) => setToken(event.target.value)} placeholder=\"Enter ADMIN_TOKEN\" /></label><button className=\"button button-coral\" disabled={loading}>{loading ? \"Opening...\" : \"Open dashboard\"}<ArrowIcon /></button>{error && <p className=\"admin-error\">{error}</p>}</form></div></section>;\n109: \n110:   const type = contentTypes.find((entry) => entry.key === active);\n111:   const items = dashboard.content?.[active] || [];\n112:   const commentCount = Object.values(dashboard.engagement || {}).reduce((total, entry) => total + (entry.comments || []).length, 0);\n113:   const totalSubmissions = (dashboard.submissions?.leads?.length || 0) + (dashboard.submissions?.applications?.length || 0) + commentCount;\n114:   return <section className=\"admin-shell\"><aside className=\"admin-sidebar\"><div className=\"admin-logo\"><span>GF</span><div><strong>Get Into Feed</strong><small>ADMIN</small></div></div><nav><button className={active === \"submissions\" ? \"active\" : \"\"} onClick={() => { setActive(\"submissions\"); setEditing(null); }}><MessageSquare size={17} />Inbox <b>{totalSubmissions}</b></button>{contentTypes.map((entry) => <button key={entry.key} className={active === entry.key ? \"active\" : \"\"} onClick={() => { setActive(entry.key); setEditing(null); }}><FileText size={17} />{entry.label}</button>)}</nav><button className=\"admin-refresh\" onClick={() => loadDashboard()}><RefreshCw size={15} />Refresh data</button></aside><main className=\"admin-main\"><header><div><span>Content manager</span><h1>{active === \"submissions\" ? \"Website inbox\" : type.label}</h1></div>{active !== \"submissions\" && <button className=\"button button-coral\" onClick={() => setEditing({})}><Plus size={17} />Add {type.label.slice(0, -1)}</button>}</header>{error && <p className=\"admin-error\">{error}</p>}{active === \"submissions\" ? <Submissions submissions={dashboard.submissions} engagement={dashboard.engagement} /> : <><div className=\"admin-summary\"><div><BarChart3 size={20} /><span>Published</span><strong>{items.length}</strong></div><div><LayoutDashboard size={20} /><span>Content type</span><strong>{type.label}</strong></div></div>{editing && <ContentForm type={active} item={editing.id ? editing : null} onCancel={() => setEditing(null)} onSaved={async () => { setEditing(null); await loadDashboard(); }} request={request} />}<div className=\"content-list\">{items.map((item) => <article key={item.id}><div><span>{item[type.subtitle] || \"Published item\"}</span><h3>{item[type.title]}</h3></div><div><button className=\"icon-button\" aria-label=\"Edit content\" onClick={() => setEditing(item)}><Pencil size={16} /></button><button className=\"icon-button danger\" aria-label=\"Delete content\" onClick={() => remove(item)}><Trash2 size={16} /></button></div></article>)}</div></>}</main></section>;\n115: }\n116: \n117: function ArrowIcon() { return <span aria-hidden=\"true\">-&gt;</span>; }\n118: \nThe abo